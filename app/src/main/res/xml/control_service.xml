<?xml version="1.0" encoding="utf-8"?>
<!-- Control by Numio uses the accessibility service only to draw the panel and its
     edge handle over other apps, and for the lock screen, screenshot and power menu
     actions. No event types and canRetrieveWindowContent="false": it never sees
     what is on the screen or what you type.
     No accessibilityFlags: asking for the accessibility button makes Android
     (11 and newer) show only a "shortcut" switch instead of an On switch. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:settingsActivity="com.rr.numio.control.MainActivity" />
